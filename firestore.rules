rules_version = '2';

// Aturan Cloud Firestore untuk ZUI Studiku.
// Struktur data dan cara pakainya dijelaskan di README bagian "Firebase".
//
//   users/{uid}                      data lengkap pengguna (isi S di app.html), hanya pemilik
//   pantau/{uid}                     ringkasan untuk orang tua: tanpa catatan pelajaran
//   plans/{uid}                      paket aktif, hanya admin yang boleh menulis
//   codes/{kode}                     kode grup -> id grup, hanya bisa dibuka satu per satu
//   groups/{uidPemilik}              satu grup per pemilik, id grup = uid pemilik
//   groups/{gid}/members/{uid}       anggota grup
//   groups/{gid}/items/{id}          tugas dan jadwal kelas (grup sekolah)

service cloud.firestore {
  match /databases/{database}/documents {

    // Email wajib terverifikasi (akun Google otomatis terverifikasi).
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function grpExists(gid) { return exists(/databases/$(database)/documents/groups/$(gid)); }
    function grpExistsAfter(gid) { return existsAfter(/databases/$(database)/documents/groups/$(gid)); }
    function grp(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data; }
    function grpAfter(gid) { return getAfter(/databases/$(database)/documents/groups/$(gid)).data; }

    function isMember(gid, uid) {
      return exists(/databases/$(database)/documents/groups/$(gid)/members/$(uid));
    }
    function isMemberAfter(gid, uid) {
      return existsAfter(/databases/$(database)/documents/groups/$(gid)/members/$(uid));
    }

    function planActive(uid, kind) {
      return exists(/databases/$(database)/documents/plans/$(uid))
        && get(/databases/$(database)/documents/plans/$(uid)).data.plan == kind
        && get(/databases/$(database)/documents/plans/$(uid)).data.until > request.time;
    }

    // ---- Data pengguna ----

    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && onlyKeys(['data', 'updatedAt'])
        && request.resource.data.data is map;
    }

    // Ringkasan yang boleh dilihat orang tua di grup keluarga.
    // Sengaja tidak memuat catatan pelajaran.
    match /pantau/{uid} {
      allow read: if isMe(uid)
        || (signedIn()
            && isMember(request.auth.uid, uid)
            && grp(request.auth.uid).kind == 'keluarga');
      allow create, update: if isMe(uid)
        && onlyKeys(['nick', 'jadwal', 'kegiatan', 'rencana', 'sesi', 'mnt', 'updatedAt']);
      allow delete: if isMe(uid);
    }

    // ---- Paket ----
    // Diaktifkan admin lewat konsol Firebase (konsol tidak terikat aturan ini)
    // atau lewat akun dengan custom claim admin: true.
    // Anggota grup boleh membaca paket pemilik grup, supaya anak di grup keluarga
    // tahu apakah Premium dari orang tuanya masih aktif.

    match /plans/{uid} {
      allow read: if isMe(uid) || isAdmin() || (signedIn() && isMember(uid, request.auth.uid));
      allow delete: if isMe(uid) || isAdmin();
      allow create, update: if isAdmin()
        && onlyKeys(['plan', 'until', 'note'])
        && request.resource.data.plan in ['free', 'pelajar', 'keluarga', 'sekolah']
        && request.resource.data.until is timestamp;
    }

    // ---- Grup ----

    // Kode hanya bisa dibuka satu per satu (tidak bisa didaftar), jadi kode tidak bisa ditebak massal.
    // Dibuat dalam satu batch bersama dokumen grupnya. Kode yang sudah dipakai tidak bisa ditimpa.
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.size() >= 8
        && onlyKeys(['gid'])
        && request.resource.data.gid == request.auth.uid
        && grpExistsAfter(request.auth.uid)
        && grpAfter(request.auth.uid).code == code;
      allow delete: if signedIn() && resource.data.gid == request.auth.uid;
    }

    match /groups/{gid} {
      allow get: if isMe(gid) || (signedIn() && isMember(gid, request.auth.uid));
      allow list: if false;

      // Hanya pemilik paket keluarga atau sekolah yang aktif.
      allow create: if isMe(gid)
        && onlyKeys(['name', 'kind', 'ownerId', 'code', 'count', 'createdAt'])
        && request.resource.data.ownerId == gid
        && request.resource.data.kind in ['keluarga', 'sekolah']
        && planActive(gid, request.resource.data.kind)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 8
        && existsAfter(/databases/$(database)/documents/codes/$(request.resource.data.code))
        && request.resource.data.count == 0
        && request.resource.data.createdAt == request.time;

      // Pemilik boleh mengganti nama. Jumlah anggota (count) hanya berubah
      // bersamaan dengan anggota yang bergabung atau keluar sendiri.
      allow update: if
        (isMe(gid)
          && changedOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60)
        || (signedIn() && changedOnly(['count'])
          && ((request.resource.data.count == resource.data.count + 1
                && !isMember(gid, request.auth.uid)
                && isMemberAfter(gid, request.auth.uid))
              || (request.resource.data.count == resource.data.count - 1
                && isMember(gid, request.auth.uid)
                && !isMemberAfter(gid, request.auth.uid))));

      allow delete: if isMe(gid);

      match /members/{uid} {
        allow read: if isMe(uid) || isMe(gid);

        // Bergabung harus memakai kode grup yang benar, saat paket pemilik masih aktif,
        // dan menaikkan count di batch yang sama. Grup keluarga maksimal 3 anak.
        allow create: if isMe(uid)
          && uid != gid
          && onlyKeys(['uid', 'code', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.joinedAt == request.time
          && grpExists(gid)
          && request.resource.data.code == grp(gid).code
          && planActive(gid, grp(gid).kind)
          && grpAfter(gid).count == grp(gid).count + 1
          && (grp(gid).kind != 'keluarga' || grpAfter(gid).count <= 3);

        allow update: if false;

        // Anggota keluar sendiri (count turun di batch yang sama),
        // atau pemilik membersihkan anggota setelah grupnya dihapus.
        allow delete: if (isMe(uid) || isMe(gid))
          && (!grpExistsAfter(gid) || grpAfter(gid).count == grp(gid).count - 1);
      }

      match /items/{itemId} {
        allow read: if isMe(gid) || (signedIn() && isMember(gid, request.auth.uid));
        allow create: if isMe(gid)
          && grpExists(gid)
          && grp(gid).kind == 'sekolah'
          && planActive(gid, 'sekolah')
          && onlyKeys(['kind', 'data', 'createdAt'])
          && request.resource.data.kind in ['tugas', 'jadwal']
          && request.resource.data.data is map
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isMe(gid);
      }
    }

    // Supaya pengguna bisa mencari grup yang ia ikuti:
    // collectionGroup('members').where('uid', '==', uidSendiri)
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
