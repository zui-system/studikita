rules_version = '2';

// Aturan Cloud Firestore untuk ZUI Studiku (project sudiku-zui).
// Paket, permintaan bayar, harga, dan chat memakai pola "standar" Zui Admin
// (sama dengan ZUI KONTRAKTOR, ZUI JURNAL, ZUI TO-DO). Lihat README bagian 9.
//
//   companies/{uid}                    paket pengguna (ID = UID). plan, until, free hanya diubah admin ZUI
//   companies/{uid}/members/{uid}      email pemilik, dibaca Zui Admin
//   subreqs/{id}                       permintaan bayar (antrean Zui Admin)
//   zconfig/pay                        harga, QRIS, catatan pembayaran (diatur di Zui Admin)
//   support/{uid}, support/{uid}/msgs  chat dengan admin ZUI
//   users/{uid}                        data lengkap pengguna (isi S di app.html), hanya pemilik
//   pantau/{uid}                       ringkasan untuk orang tua: tanpa catatan pelajaran
//   codes/{kode}                       kode grup -> id grup, hanya bisa dibuka satu per satu
//   groups/{gid}                       grup. Pemilik = field ownerId. Grup keluarga dan grup lama:
//                                      id = uid pemilik. Kelas sekolah baru: id acak 20 karakter,
//                                      jadi satu guru bisa punya beberapa kelas
//   groups/{gid}/anggota/{uid}         anggota grup (dengan nama panggilan, dilihat pemilik)
//   groups/{gid}/items/{id}            tugas dan jadwal kelas (grup sekolah)
//   groups/{gid}/items/{id}/selesai/{uid}  tanda tugas kelas selesai, dibaca siswa itu dan guru
//   groups/{gid}/items/{id}/nilai/{uid}    nilai tugas dari guru, dibaca siswa itu dan guru
//   groups/{gid}/pengajar/{uid}        guru yang mengajar di kelas sekolah beserta mapelnya (diatur sekolah)
//   profil/{uid}                       data pendaftaran (peran murid/ortu/guru/sekolah), hanya pemilik
//   schools/{uidSekolah}               sekolah; kelas sekolah = groups dengan field school
//   schools/{sid}/guru/{uid}           guru yang bergabung dengan kode guru
//   kodeguru/{kode}                    kode guru -> id sekolah, hanya bisa dibuka satu per satu
//   groups/{gid}/absen/{sesi}/hadir/{uid}  absensi per pertemuan (H, I, S, A)
//   groups/{gid}/wali/{uidOrtu}        orang tua murid di kelas ini (ditulis anak), untuk pantauan orang tua
//   groups/{gid}/chat/{uidOrtu_uidGuru} pesan antara orang tua dan guru yang mengajar anaknya
//   schools/{sid}/info/{id}            pengumuman sekolah untuk semua
//   schools/{sid}/program/{id}         program sekolah dan statusnya (sekolah dan gurunya)
//   schools/{sid}/pesan/{uidGuru}/msgs pesan pribadi antara sekolah dan satu guru
//
// Paket Studiku di Zui Admin: starter = Guru, pro = Orang tua, business = Sekolah (Manajemen atau
// Terpadu; Terpadu dan kuota murid ditetapkan admin ZUI di schools/{sid}). Murid gratis.

service cloud.firestore {
  match /databases/{database}/documents {

    // Email wajib terverifikasi (akun Google otomatis terverifikasi).
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // Akun admin ZUI (samakan dengan adminEmail di config.js Zui Admin).
    function superAdmin() {
      return signedIn() && request.auth.token.email.lower() in ['admin.zuisystem@gmail.com'];
    }

    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function grpExists(gid) { return exists(/databases/$(database)/documents/groups/$(gid)); }
    function grpExistsAfter(gid) { return existsAfter(/databases/$(database)/documents/groups/$(gid)); }
    function grp(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data; }
    function grpAfter(gid) { return getAfter(/databases/$(database)/documents/groups/$(gid)).data; }

    function isMember(gid, uid) {
      return exists(/databases/$(database)/documents/groups/$(gid)/anggota/$(uid));
    }
    function isMemberAfter(gid, uid) {
      return existsAfter(/databases/$(database)/documents/groups/$(gid)/anggota/$(uid));
    }

    // Paket berbayar yang masih aktif (termasuk tenggang 3 hari, sama dengan Zui Admin),
    // gratis selamanya, atau masa percobaan. Grup keluarga butuh paket pro, kelas sekolah butuh
    // paket business. Masa percobaan (14 hari sejak akun dibuat, paling awal 23 Okt 2026, dan
    // belum pernah berbayar) membuka semua fitur, termasuk grup keluarga dan kelas sekolah.
    // Samakan dengan TRIAL dan LAUNCH di app.html.
    // Paket per peran (Zui Admin): starter = Guru, pro = Orang tua, business = Sekolah.
    // kind: 'guru' | 'keluarga' (orang tua) | 'sekolah'. Murid gratis, tidak butuh paket.
    function planActive(uid, kind) {
      let p = /databases/$(database)/documents/companies/$(uid);
      return exists(p) && (get(p).data.get('free', false) == true
        || (get(p).data.get('until', null) != null
            && get(p).data.get('plan', '') == (kind == 'keluarga' ? 'pro' : kind == 'guru' ? 'starter' : 'business')
            && request.time < get(p).data.until + duration.value(3, 'd'))
        || inTrial(uid));
    }
    function inTrial(uid) {
      let p = /databases/$(database)/documents/companies/$(uid);
      return exists(p) && get(p).data.get('until', null) == null
        && (request.time < get(p).data.created_at + duration.value(14, 'd')
            || request.time < timestamp.date(2026, 10, 23) + duration.value(14, 'd'));
    }
    // Guru aktif: paket Guru sendiri (paket Sekolah lama juga dihitung), atau ditanggung sekolah
    // tempatnya mengajar (via = uid sekolah) yang paket Sekolahnya aktif.
    function guruActive(uid, via) {
      return planActive(uid, 'guru') || planActive(uid, 'sekolah')
        || (via != '' && isGuruOf(via, uid) && planActive(via, 'sekolah'));
    }
    // Sekolah Terpadu: semua tersambung (kelas milik sekolah, guru dan orang tua ditanggung).
    // Ditetapkan admin ZUI; selama masa percobaan dianggap Terpadu.
    function terpadu(sid) {
      return inTrial(sid)
        || get(/databases/$(database)/documents/schools/$(sid)).data.get('terpadu', false) == true;
    }

    // Salinan status paket untuk kelas sekolah (field pk di groups), harus sama dengan companies/{uid}.
    function pkOf(uid) {
      let c = get(/databases/$(database)/documents/companies/$(uid)).data;
      return {'plan': c.get('plan', ''), 'until': c.get('until', null), 'free': c.get('free', false), 'created_at': c.get('created_at', null)};
    }

    // ---- Paket (pola standar Zui Admin) ----

    match /companies/{cid} {
      allow read: if isMe(cid) || superAdmin() || (signedIn() && isMember(cid, request.auth.uid))
        || (signedIn() && isGuruOf(cid, request.auth.uid));
      // Pengguna tidak bisa mengisi paket, masa aktif, atau status gratis sendiri.
      allow create: if isMe(cid)
        && onlyKeys(['name', 'owner', 'created_at'])
        && request.resource.data.owner == cid
        && request.resource.data.created_at == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;
      allow update: if superAdmin()
        || (isMe(cid) && changedOnly(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 120);
      allow delete: if isMe(cid);

      match /members/{uid} {
        allow read: if isMe(cid) || superAdmin();
        allow create, update: if isMe(uid) && uid == cid
          && onlyKeys(['role', 'email', 'name'])
          && request.resource.data.role == 'owner'
          && request.resource.data.email == request.auth.token.email.lower();
        allow delete: if isMe(cid);
      }
    }

    match /zconfig/{id} {
      allow read: if signedIn();
      allow write: if superAdmin();
    }

    // Permintaan bayar manual. Pelanggan hanya bisa membuat permintaan berstatus 'wait'
    // untuk akunnya sendiri; mengaktifkan atau menolak hanya lewat Zui Admin.
    match /subreqs/{id} {
      allow create: if signedIn()
        && onlyKeys(['cid', 'coName', 'plan', 'months', 'amount', 'cur', 'ref', 'by', 'byEmail', 'status', 'at'])
        && request.resource.data.cid == request.auth.uid
        && request.resource.data.by == request.auth.uid
        && exists(/databases/$(database)/documents/companies/$(request.auth.uid))
        && request.resource.data.status == 'wait'
        && request.resource.data.at == request.time
        && request.resource.data.plan in ['starter', 'pro', 'business']
        && request.resource.data.months in [1, 6, 12]
        && request.resource.data.amount is number
        && request.resource.data.cur in ['IDR', 'MYR']
        && request.resource.data.ref is string
        && request.resource.data.ref.size() > 0
        && request.resource.data.ref.size() <= 60
        && request.resource.data.coName is string
        && request.resource.data.coName.size() <= 120
        && request.resource.data.byEmail is string
        && request.resource.data.byEmail.size() <= 120;
      allow read: if superAdmin() || (signedIn() && resource.data.cid == request.auth.uid);
      allow update, delete: if superAdmin();
    }

    // Chat dengan admin ZUI. support/{uid} berisi ringkasan, support/{uid}/msgs isi pesan
    // (boleh berisi foto bukti bayar yang sudah dikecilkan).
    match /support/{cid} {
      function okHead() {
        let d = request.resource.data;
        return d.keys().hasOnly(['cid', 'coName', 'byEmail', 'last', 'at', 'from', 'unread', 'seen'])
          && d.cid == cid && d.from == 'u' && d.unread == true && d.seen == true && d.at == request.time
          && d.coName is string && d.coName.size() <= 120
          && d.byEmail is string && d.byEmail.size() <= 120
          && d.last is string && d.last.size() <= 120;
      }
      allow read: if isMe(cid) || superAdmin();
      allow create: if superAdmin() || (isMe(cid) && okHead());
      allow update: if superAdmin() || (isMe(cid) && okHead())
        || (isMe(cid) && changedOnly(['seen']) && request.resource.data.seen == true);
      allow delete: if superAdmin();

      match /msgs/{id} {
        allow read: if isMe(cid) || superAdmin();
        allow create: if onlyKeys(['from', 'name', 'text', 'img', 'at', 'uid'])
          && request.resource.data.at == request.time
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && request.resource.data.img is string && request.resource.data.img.size() <= 400000
          && (request.resource.data.text.size() > 0 || request.resource.data.img.size() > 0)
          && ((isMe(cid) && request.resource.data.from == 'u')
              || (superAdmin() && request.resource.data.from == 'a'));
        allow update: if false;
        allow delete: if superAdmin();
      }
    }

    // ---- Data pengguna ----

    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && onlyKeys(['data', 'updatedAt'])
        && request.resource.data.data is map;
    }

    // Ringkasan yang boleh dilihat orang tua di grup keluarga.
    // Sengaja tidak memuat catatan pelajaran.
    match /pantau/{uid} {
      allow read: if isMe(uid)
        || (signedIn()
            && isMember(request.auth.uid, uid)
            && grp(request.auth.uid).kind == 'keluarga');
      allow create, update: if isMe(uid)
        && onlyKeys(['nick', 'jadwal', 'kegiatan', 'rencana', 'sesi', 'mnt', 'updatedAt', 'sek'])
        && (!('sek' in request.resource.data)
            || (request.resource.data.sek is list && request.resource.data.sek.size() <= 10));
      allow delete: if isMe(uid);
    }

    // ---- Profil pendaftaran ----

    function optStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function okProfil() {
      let d = request.resource.data;
      return d.keys().hasOnly(['peran', 'nama', 'hp', 'alamat', 'jenjang', 'kelas', 'jurusan', 'sekolah',
          'anak', 'mapel', 'ajar', 'instansi', 'jenis', 'npsn', 'jabatan', 'jumlah', 'kode', 'at'])
        && d.peran in ['murid', 'ortu', 'guru', 'sekolah']
        && d.nama is string && d.nama.size() > 0 && d.nama.size() <= 80
        && d.hp is string && d.hp.size() >= 8 && d.hp.size() <= 20
        && d.alamat is string && d.alamat.size() > 0 && d.alamat.size() <= 200
        && optStr(d, 'jenjang', 40) && optStr(d, 'kelas', 40) && optStr(d, 'jurusan', 80)
        && optStr(d, 'sekolah', 120) && optStr(d, 'anak', 4) && optStr(d, 'mapel', 120)
        && optStr(d, 'ajar', 120) && optStr(d, 'instansi', 120) && optStr(d, 'jenis', 40)
        && optStr(d, 'npsn', 20) && optStr(d, 'jabatan', 80) && optStr(d, 'jumlah', 40)
        && optStr(d, 'kode', 20)
        && d.at == request.time;
    }
    function peran(uid) { return get(/databases/$(database)/documents/profil/$(uid)).data.peran; }

    // Peran dipilih sekali saat daftar dan tidak bisa diganti sendiri (lewat admin ZUI).
    match /profil/{uid} {
      allow read, delete: if isMe(uid);
      allow create: if isMe(uid) && okProfil();
      allow update: if isMe(uid) && okProfil() && request.resource.data.peran == resource.data.peran;
    }

    // ---- Sekolah ----

    function isGuruOf(sid, uid) {
      return exists(/databases/$(database)/documents/schools/$(sid)/guru/$(uid));
    }

    // Kode guru hanya bisa dibuka satu per satu, dibuat bersama dokumen sekolahnya.
    match /kodeguru/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.size() >= 8
        && onlyKeys(['sid'])
        && request.resource.data.sid == request.auth.uid
        && getAfter(/databases/$(database)/documents/schools/$(request.auth.uid)).data.codeGuru == code;
      allow delete: if signedIn() && resource.data.sid == request.auth.uid;
    }

    // Satu sekolah per akun berperan sekolah (id = uid admin sekolah).
    match /schools/{sid} {
      function okSchool() {
        let d = request.resource.data;
        return d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && d.jenjang is string && d.jenjang.size() <= 40
          && d.alamat is string && d.alamat.size() <= 200;
      }
      allow get: if isMe(sid) || superAdmin() || (signedIn() && isGuruOf(sid, request.auth.uid));
      allow list: if superAdmin();
      allow create: if isMe(sid)
        && onlyKeys(['name', 'jenjang', 'alamat', 'ownerId', 'codeGuru', 'createdAt'])
        && okSchool()
        && request.resource.data.ownerId == sid
        && request.resource.data.codeGuru is string
        && request.resource.data.codeGuru.size() >= 8
        && existsAfter(/databases/$(database)/documents/kodeguru/$(request.resource.data.codeGuru))
        && request.resource.data.createdAt == request.time
        && peran(sid) == 'sekolah';
      allow update: if (isMe(sid) && changedOnly(['name', 'jenjang', 'alamat']) && okSchool())
        // sekolah mengajukan paket (Manajemen atau Terpadu dengan kuota murid); admin ZUI yang menetapkan
        || (isMe(sid) && changedOnly(['minta'])
            && request.resource.data.minta.keys().hasOnly(['terpadu', 'kuota', 'at'])
            && request.resource.data.minta.terpadu is bool
            && request.resource.data.minta.kuota is int
            && request.resource.data.minta.kuota >= 0 && request.resource.data.minta.kuota <= 100000
            && request.resource.data.minta.at == request.time)
        || (superAdmin() && changedOnly(['terpadu', 'kuota'])
            && request.resource.data.get('terpadu', false) is bool
            && request.resource.data.get('kuota', 0) is int);
      allow delete: if isMe(sid);

      // Guru bergabung dengan kode guru dari sekolah. Sekolah bisa mengeluarkan guru.
      match /guru/{uid} {
        allow read: if isMe(uid) || isMe(sid);
        allow create: if isMe(uid)
          && uid != sid
          && onlyKeys(['uid', 'nama', 'code', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.nama is string
          && request.resource.data.nama.size() > 0
          && request.resource.data.nama.size() <= 80
          && request.resource.data.joinedAt == request.time
          && exists(/databases/$(database)/documents/schools/$(sid))
          && request.resource.data.code == get(/databases/$(database)/documents/schools/$(sid)).data.codeGuru
          && peran(uid) == 'guru';
        allow update: if isMe(uid)
          && changedOnly(['nama'])
          && request.resource.data.nama is string
          && request.resource.data.nama.size() > 0
          && request.resource.data.nama.size() <= 80;
        allow delete: if isMe(uid) || isMe(sid);
      }

      // Pengumuman untuk semua: guru, murid di kelas sekolah ini, dan orang tuanya.
      // Bisa dibaca semua pengguna yang masuk dan tahu id sekolahnya; jangan berisi data pribadi.
      match /info/{id} {
        allow read: if signedIn();
        allow create, update: if isMe(sid)
          && onlyKeys(['judul', 'isi', 'dari', 'at'])
          && request.resource.data.judul is string
          && request.resource.data.judul.size() > 0
          && request.resource.data.judul.size() <= 120
          && request.resource.data.isi is string
          && request.resource.data.isi.size() <= 2000
          && request.resource.data.dari is string
          && request.resource.data.dari.size() <= 120
          && request.resource.data.at == request.time;
        allow delete: if isMe(sid);
      }

      // Program sekolah: dikelola sekolah, dibaca sekolah dan gurunya.
      match /program/{id} {
        allow read: if isMe(sid) || (signedIn() && isGuruOf(sid, request.auth.uid));
        allow create, update: if isMe(sid)
          && onlyKeys(['nama', 'pj', 'status', 'progres', 'catatan', 'at'])
          && request.resource.data.nama is string
          && request.resource.data.nama.size() > 0
          && request.resource.data.nama.size() <= 120
          && request.resource.data.pj is string
          && request.resource.data.pj.size() <= 80
          && request.resource.data.status in ['Direncanakan', 'Berjalan', 'Selesai']
          && request.resource.data.progres is int
          && request.resource.data.progres >= 0
          && request.resource.data.progres <= 100
          && request.resource.data.catatan is string
          && request.resource.data.catatan.size() <= 500
          && request.resource.data.at == request.time;
        allow delete: if isMe(sid);
      }

      // Pesan pribadi antara sekolah dan satu guru (id = uid guru). Guru lain tidak bisa membaca.
      // Guru yang sudah keluar atau dikeluarkan dari sekolah tidak bisa membuka lagi.
      match /pesan/{guid} {
        function pihak() { return isMe(sid) || (isMe(guid) && isGuruOf(sid, guid)); }
        function okDari(d) { return (isMe(sid) && d == 'sekolah') || (isMe(guid) && d == 'guru'); }
        allow read: if pihak();
        allow create, update: if pihak()
          && onlyKeys(['last', 'dari', 'at'])
          && request.resource.data.last is string
          && request.resource.data.last.size() <= 120
          && okDari(request.resource.data.dari)
          && request.resource.data.at == request.time;
        allow delete: if isMe(sid);

        match /msgs/{id} {
          allow read: if pihak();
          allow create: if pihak()
            && onlyKeys(['dari', 't', 'uid', 'at'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.t is string
            && request.resource.data.t.size() > 0
            && request.resource.data.t.size() <= 2000
            && okDari(request.resource.data.dari)
            && request.resource.data.at == request.time;
          allow update: if false;
          allow delete: if isMe(sid);
        }
      }
    }

    // ---- Grup ----

    // Pemilik grup menurut field ownerId (grup lama juga punya ownerId = id grup).
    function ownsGrp(gid) {
      return signedIn() && grpExists(gid) && grp(gid).ownerId == request.auth.uid;
    }
    function grpOpen(gid) { return grp(gid).get('closed', false) == false; }
    function okNick(d) { return !('nick' in d) || (d.nick is string && d.nick.size() <= 60); }
    // Guru yang ditugaskan sekolah mengajar di kelas ini.
    function isPengajar(gid) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(gid)/pengajar/$(request.auth.uid));
    }
    // Orang tua (pemilik grup keluarga) dari murid uid.
    function isParentOf(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(request.auth.uid)/anggota/$(uid))
        && grp(request.auth.uid).kind == 'keluarga';
    }
    // Orang tua dari salah satu murid di kelas ini (tercatat lewat wali).
    function isWali(gid) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(gid)/wali/$(request.auth.uid));
    }
    // Orang tua bisa memantau kelas anaknya bila paket Orang tua aktif, atau kelasnya milik
    // sekolah Terpadu yang paketnya aktif (ditanggung sekolah).
    function waliAktif(gid) {
      return isWali(gid) && (planActive(request.auth.uid, 'keluarga')
        || (grp(gid).get('school', '') != '' && planActive(grp(gid).school, 'sekolah') && terpadu(grp(gid).school)));
    }
    // Kelas aktif: kelas sekolah = paket Sekolah aktif; kelas guru = guru pemiliknya aktif.
    function classActive(gid) {
      return grp(gid).get('school', '') != ''
        ? planActive(grp(gid).school, 'sekolah')
        : guruActive(grp(gid).ownerId, grp(gid).get('via', ''));
    }
    // Yang mengajar di kelas ini: pemilik kelas atau guru pengajar.
    function canTeach(gid) { return ownsGrp(gid) || isPengajar(gid); }

    // Kode hanya bisa dibuka satu per satu (tidak bisa didaftar), jadi kode tidak bisa ditebak massal.
    // Dibuat dalam satu batch bersama dokumen grupnya. Kode yang sudah dipakai tidak bisa ditimpa.
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.size() >= 8
        && onlyKeys(['gid'])
        && grpExistsAfter(request.resource.data.gid)
        && grpAfter(request.resource.data.gid).ownerId == request.auth.uid
        && grpAfter(request.resource.data.gid).code == code;
      allow delete: if signedIn()
        && (resource.data.gid == request.auth.uid || ownsGrp(resource.data.gid));
    }

    match /groups/{gid} {
      function owner() { return signedIn() && resource.data.ownerId == request.auth.uid; }

      allow get: if isMe(gid) || owner() || superAdmin() || isPengajar(gid) || waliAktif(gid) || (signedIn() && isMember(gid, request.auth.uid));
      // Pemilik boleh mendaftar grupnya sendiri: where('ownerId', '==', uid). Admin ZUI menghitung murid sekolah.
      allow list: if owner() || superAdmin();

      // Hanya pemilik paket keluarga atau sekolah yang aktif. Grup keluarga tetap satu per
      // pemilik (id = uid pemilik). Kelas sekolah boleh banyak, id acak 20 karakter
      // (UID Firebase 28 karakter, jadi id kelas tidak bisa menyamar sebagai UID orang lain).
      // Kelas milik sekolah menyimpan field school = uid sekolah (pembuatnya sendiri).
      allow create: if signedIn()
        && onlyKeys(['name', 'kind', 'ownerId', 'code', 'count', 'createdAt', 'school', 'via'])
        && (!('school' in request.resource.data)
            || (request.resource.data.school == request.auth.uid
                && request.resource.data.kind == 'sekolah'
                && !('via' in request.resource.data)
                && exists(/databases/$(database)/documents/schools/$(request.auth.uid))
                && terpadu(request.auth.uid)))
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.kind in ['keluarga', 'sekolah']
        && (gid == request.auth.uid
            || (gid.size() == 20 && request.resource.data.kind == 'sekolah'))
        // Grup keluarga gratis (hanya menyambungkan orang tua dan anak). Kelas butuh paket:
        // kelas sekolah = paket Sekolah Terpadu, kelas guru = guru aktif.
        && (request.resource.data.kind == 'keluarga'
            || ('school' in request.resource.data && planActive(request.auth.uid, 'sekolah'))
            || (!('school' in request.resource.data)
                && guruActive(request.auth.uid, request.resource.data.get('via', ''))))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 8
        && existsAfter(/databases/$(database)/documents/codes/$(request.resource.data.code))
        && request.resource.data.count == 0
        && request.resource.data.createdAt == request.time;

      // Pemilik boleh mengganti nama, atau menutup grup (closed) sebelum menghapusnya supaya
      // anggota bisa dibersihkan. Jumlah anggota (count) hanya berubah bersamaan dengan
      // anggota yang bergabung atau keluar sendiri.
      allow update: if
        (owner()
          && changedOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60)
        || (owner() && changedOnly(['closed']) && request.resource.data.closed == true)
        // Sekolah menyalin status paketnya ke kelas supaya murid ikut Premium (tidak bisa dipalsukan).
        || (owner() && changedOnly(['pk']) && request.resource.data.pk == pkOf(request.auth.uid))
        || (signedIn() && changedOnly(['count'])
          && ((request.resource.data.count == resource.data.count + 1
                && !isMember(gid, request.auth.uid)
                && isMemberAfter(gid, request.auth.uid))
              || (request.resource.data.count == resource.data.count - 1
                && isMember(gid, request.auth.uid)
                && !isMemberAfter(gid, request.auth.uid))));

      allow delete: if owner();

      match /anggota/{uid} {
        allow read: if isMe(uid) || isMe(gid) || ownsGrp(gid) || isPengajar(gid);

        // Bergabung harus memakai kode grup yang benar, saat paket pemilik masih aktif,
        // grup belum ditutup, dan menaikkan count di batch yang sama. Grup keluarga maksimal 3 anak.
        allow create: if isMe(uid)
          && uid != gid
          && onlyKeys(['uid', 'code', 'joinedAt', 'nick'])
          && request.resource.data.uid == uid
          && request.resource.data.joinedAt == request.time
          && okNick(request.resource.data)
          && grpExists(gid)
          && uid != grp(gid).ownerId
          && grpOpen(gid)
          && request.resource.data.code == grp(gid).code
          && (grp(gid).kind == 'keluarga' || classActive(gid))
          && grpAfter(gid).count == grp(gid).count + 1
          && (grp(gid).kind != 'keluarga' || grpAfter(gid).count <= 3);

        // Anggota boleh mengganti nama panggilannya yang dilihat pemilik grup.
        allow update: if isMe(uid)
          && changedOnly(['nick'])
          && request.resource.data.nick is string
          && request.resource.data.nick.size() <= 60;

        // Anggota keluar sendiri (count turun di batch yang sama), pemilik membersihkan
        // anggota setelah grupnya dihapus (grup lama), atau pemilik membersihkan anggota
        // grup yang sudah ditutup (closed).
        allow delete: if ((isMe(uid) || isMe(gid))
            && (!grpExistsAfter(gid) || grpAfter(gid).count == grp(gid).count - 1))
          || (ownsGrp(gid) && !grpOpen(gid));
      }

      // Sekolah menugaskan guru (yang sudah bergabung ke sekolahnya) beserta mapelnya.
      // Siswa di kelas boleh melihat daftar guru dan mapel.
      match /pengajar/{uid} {
        allow read: if isMe(uid) || ownsGrp(gid) || waliAktif(gid) || (signedIn() && isMember(gid, request.auth.uid));
        allow create, update: if ownsGrp(gid)
          && ((grp(gid).get('school', '') == request.auth.uid && isGuruOf(request.auth.uid, uid))
              || (grp(gid).get('school', '') == '' && grp(gid).kind == 'sekolah' && uid == request.auth.uid))
          && onlyKeys(['uid', 'nama', 'mapel', 'at'])
          && request.resource.data.uid == uid
          && request.resource.data.nama is string
          && request.resource.data.nama.size() <= 80
          && request.resource.data.mapel is list
          && request.resource.data.mapel.size() > 0
          && request.resource.data.mapel.size() <= 20
          && request.resource.data.at == request.time;
        allow delete: if isMe(uid) || ownsGrp(gid) || (isMe(gid) && !grpExists(gid));
      }

      // Anak mencatat orang tuanya (pemilik grup keluarga yang ia ikuti) di kelas yang ia ikuti,
      // supaya orang tua bisa melihat kelas, tugas, dan guru anaknya.
      match /wali/{pid} {
        allow read: if isMe(pid) || ownsGrp(gid) || isPengajar(gid);
        allow create, update: if signedIn()
          && onlyKeys(['anak', 'nick', 'at'])
          && request.resource.data.anak == request.auth.uid
          && request.resource.data.nick is string
          && request.resource.data.nick.size() <= 60
          && request.resource.data.at == request.time
          && grp(gid).kind == 'sekolah'
          && isMember(gid, request.auth.uid)
          && isMember(pid, request.auth.uid)
          && grp(pid).kind == 'keluarga';
        allow delete: if isMe(pid) || ownsGrp(gid) || (signedIn() && resource.data.anak == request.auth.uid);
      }

      // Pesan orang tua dan guru. id = uidOrtu + '_' + uidGuru. Hanya orang tua (wali di kelas ini)
      // dan guru (pengajar di kelas ini) yang bersangkutan; sekolah dan orang lain tidak bisa membaca.
      match /chat/{tid} {
        function pihak(o, g) { return (isMe(o) && waliAktif(gid)) || (isMe(g) && isPengajar(gid)); }
        function okDari(o, g, d) { return (isMe(o) && d == 'ortu') || (isMe(g) && d == 'guru'); }
        // Sekolah hanya bisa membuka percakapan saat kelas ditutup untuk dihapus (pembersihan).
        allow read: if (signedIn() && pihak(resource.data.ortu, resource.data.guru)) || (ownsGrp(gid) && !grpOpen(gid));
        allow create, update: if signedIn()
          && onlyKeys(['ortu', 'guru', 'anak', 'last', 'dari', 'at'])
          && tid == request.resource.data.ortu + '_' + request.resource.data.guru
          && pihak(request.resource.data.ortu, request.resource.data.guru)
          && okDari(request.resource.data.ortu, request.resource.data.guru, request.resource.data.dari)
          && exists(/databases/$(database)/documents/groups/$(gid)/wali/$(request.resource.data.ortu))
          && exists(/databases/$(database)/documents/groups/$(gid)/pengajar/$(request.resource.data.guru))
          && request.resource.data.anak is string && request.resource.data.anak.size() <= 60
          && request.resource.data.last is string && request.resource.data.last.size() <= 120
          && request.resource.data.at == request.time;
        allow delete: if ownsGrp(gid);

        match /msgs/{id} {
          allow read: if pihak(tid.split('_')[0], tid.split('_')[1]) || (ownsGrp(gid) && !grpOpen(gid));
          allow create: if pihak(tid.split('_')[0], tid.split('_')[1])
            && onlyKeys(['dari', 't', 'uid', 'at'])
            && request.resource.data.uid == request.auth.uid
            && okDari(tid.split('_')[0], tid.split('_')[1], request.resource.data.dari)
            && request.resource.data.t is string
            && request.resource.data.t.size() > 0
            && request.resource.data.t.size() <= 2000
            && request.resource.data.at == request.time;
          allow update: if false;
          allow delete: if ownsGrp(gid);
        }
      }

      // Absensi per pertemuan: sesi {tgl, mapel, by, at}, status tiap murid di hadir/{uid}
      // (H hadir, I izin, S sakit, A alpa). Murid hanya melihat statusnya sendiri.
      match /absen/{sesi} {
        allow read: if canTeach(gid) || (signedIn() && isMember(gid, request.auth.uid)) || waliAktif(gid);
        allow create, update: if canTeach(gid)
          && grpOpen(gid)
          && classActive(gid)
          && onlyKeys(['tgl', 'mapel', 'by', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.tgl is string && request.resource.data.tgl.size() == 10
          && request.resource.data.mapel is string && request.resource.data.mapel.size() <= 60
          && request.resource.data.at == request.time;
        allow delete: if canTeach(gid);

        match /hadir/{uid} {
          allow read: if isMe(uid) || isParentOf(uid) || canTeach(gid);
          allow create, update: if canTeach(gid)
            && isMember(gid, uid)
            && onlyKeys(['uid', 's', 'tgl', 'mapel', 'at'])
            && request.resource.data.uid == uid
            && request.resource.data.s in ['H', 'I', 'S', 'A']
            && request.resource.data.tgl is string && request.resource.data.tgl.size() == 10
            && request.resource.data.mapel is string && request.resource.data.mapel.size() <= 60
            && request.resource.data.at == request.time;
          allow delete: if canTeach(gid) || isMe(uid);
        }
      }

      match /items/{itemId} {
        allow read: if isMe(gid) || ownsGrp(gid) || isPengajar(gid) || waliAktif(gid) || (signedIn() && isMember(gid, request.auth.uid));
        allow create: if ownsGrp(gid)
          && grp(gid).kind == 'sekolah'
          && grpOpen(gid)
          && classActive(gid)
          && onlyKeys(['kind', 'data', 'createdAt'])
          && request.resource.data.kind in ['tugas', 'jadwal']
          && request.resource.data.data is map
          && request.resource.data.createdAt == request.time;
        // Guru pengajar memberi tugas untuk mapel yang ia ajar di kelas ini.
        allow create: if isPengajar(gid)
          && grp(gid).kind == 'sekolah'
          && grpOpen(gid)
          && classActive(gid)
          && onlyKeys(['kind', 'data', 'createdAt', 'by', 'mapel'])
          && request.resource.data.kind == 'tugas'
          && request.resource.data.by == request.auth.uid
          && request.resource.data.mapel in get(/databases/$(database)/documents/groups/$(gid)/pengajar/$(request.auth.uid)).data.mapel
          && request.resource.data.data is map
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isMe(gid) || ownsGrp(gid)
          || (signedIn() && resource.data.get('by', '') == request.auth.uid);

        function itemBy() {
          return get(/databases/$(database)/documents/groups/$(gid)/items/$(itemId)).data.get('by', '');
        }
        // Guru pemberi tugas (atau pemilik kelas) memberi nilai 0 sampai 100.
        // Siswa hanya melihat nilainya sendiri.
        match /nilai/{uid} {
          function canGrade() { return ownsGrp(gid) || (signedIn() && itemBy() == request.auth.uid); }
          allow read: if isMe(uid) || isMe(gid) || canGrade() || isParentOf(uid);
          allow create, update: if canGrade()
            && isMember(gid, uid)
            && onlyKeys(['uid', 'nilai', 'by', 'at'])
            && request.resource.data.uid == uid
            && request.resource.data.nilai is number
            && request.resource.data.nilai >= 0
            && request.resource.data.nilai <= 100
            && request.resource.data.by == request.auth.uid
            && request.resource.data.at == request.time;
          allow delete: if isMe(uid) || isMe(gid) || canGrade();
        }

        // Siswa menandai tugas kelas selesai. Guru pemilik kelas melihat siapa saja
        // (nama panggilan) yang sudah selesai. Siswa lain tidak bisa melihatnya.
        match /selesai/{uid} {
          allow read: if isMe(uid) || isMe(gid) || ownsGrp(gid) || isPengajar(gid) || isParentOf(uid);
          allow create: if isMe(uid)
            && isMember(gid, uid)
            && onlyKeys(['uid', 'nick', 'at'])
            && request.resource.data.uid == uid
            && request.resource.data.at == request.time
            && request.resource.data.nick is string
            && request.resource.data.nick.size() <= 60
            && get(/databases/$(database)/documents/groups/$(gid)/items/$(itemId)).data.kind == 'tugas';
          allow update: if false;
          allow delete: if isMe(uid) || isMe(gid) || ownsGrp(gid);
        }
      }
    }

    // Orang tua juga bisa mencari kelas, tanda selesai, dan nilai anaknya (where('uid', '==', uidAnak)).
    // Supaya pengguna bisa mencari grup yang ia ikuti:
    // collectionGroup('anggota').where('uid', '==', uidSendiri)
    match /{path=**}/anggota/{uid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isParentOf(resource.data.uid));
    }
    // Tugas kelas yang sudah ditandai selesai: collectionGroup('selesai').where('uid', '==', uidSendiri)
    match /{path=**}/selesai/{uid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isParentOf(resource.data.uid));
    }
    // Nilai milik sendiri: collectionGroup('nilai').where('uid', '==', uidSendiri)
    match /{path=**}/nilai/{uid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isParentOf(resource.data.uid));
    }
    // Kehadiran sendiri atau anak: collectionGroup('hadir').where('uid', '==', uid)
    match /{path=**}/hadir/{uid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isParentOf(resource.data.uid));
    }
    // Kelas yang diajar: collectionGroup('pengajar').where('uid', '==', uidSendiri)
    match /{path=**}/pengajar/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Sekolah tempat mengajar: collectionGroup('guru').where('uid', '==', uidSendiri)
    match /{path=**}/guru/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
